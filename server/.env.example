PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/interviewai?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_32+_random_chars
JWT_REFRESH_SECRET=replace_with_a_different_32+_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
AI_MAX_REPAIRS=2

# Optional (leave blank to log reset links to console instead of emailing)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
